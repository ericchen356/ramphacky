# Copy to .env.local and fill in. Only ANTHROPIC_API_KEY is required for the dashboard demo.

# --- Claude (required) ---
ANTHROPIC_API_KEY=sk-ant-...
# Only needed if your key is not scoped to a workspace (console.anthropic.com → Settings → Workspaces)
ANTHROPIC_WORKSPACE_ID=

# Optional model overrides (defaults in lib/llm.ts)
# ORCHESTRATOR_MODEL=claude-sonnet-5-5
# NEGOTIATOR_MODEL=claude-sonnet-5-5
# VENDOR_MODEL=claude-haiku-4-5-20251001

# --- Slack (optional; without these the bot is disabled and the dashboard still works) ---
# Bot User OAuth Token (OAuth & Permissions → after installing to the workspace)
SLACK_BOT_TOKEN=xoxb-...
# App-Level Token with the connections:write scope (Basic Information → App-Level Tokens)
SLACK_APP_TOKEN=xapp-...

# Where the "View live dashboard" button in Slack points (default http://localhost:3000)
PUBLIC_URL=http://localhost:3000

# --- Ramp (optional; cards are mocked either way — live API is a TODO in lib/finance.ts) ---
# RAMP_API_KEY=
